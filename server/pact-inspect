#!/usr/bin/env bash
# pact-inspect —— 路径无关巡检启动器
#
# 用途：让定时任务不依赖云端重置后会消失的硬编码路径（如 /root/.pact-cn/check.py）。
#       引擎本身经 paths.resolve_data_dir() 解析持久卷，本启动器只负责
#       "找到同目录下的 check.py 并运行"，参数原样透传（如 --sim-drop）。
#
# 部署要求：本文件须与 check.py、paths.py 在同一【持久】目录
#           （云端如 /workspace/.pact-cn/，本地如 skill 运行时目录）。
#
# 用法（定时任务二选一）：
#   PACT_HOME=/workspace/.pact-cn /workspace/.pact-cn/pact-inspect
#   PACT_CN_HOME=/workspace/.pact-cn /workspace/.pact-cn/pact-inspect --sim-drop c1:6

set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$HERE/check.py" "$@"
